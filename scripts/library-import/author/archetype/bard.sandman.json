{
 "archetype": {
  "class": "bard",
  "url": "https://aonprd.com/ArchetypeDisplay.aspx?FixedName=Bard%20Sandman",
  "examples": [
   {
    "level": 6,
    "expect": {
     "amounts.sneak attack": 1
    }
   },
   {
    "level": 20,
    "expect": {
     "amounts.sneak attack": 4
    }
   }
  ]
 },
 "features": {
  "Bardic Performance": {
   "shownIn": "specialAttack"
  },
  "Master of Deception": {
   "shownIn": "specialQuality"
  },
  "Sneakspell": {
   "shownIn": "specialAttack",
   "adjustments": {
    "spells.*.dcBonus[foes denied their Dex bonus]": 1,
    "spells.*.casterLevel[spell resistance of foes denied their Dex bonus]": 0
   },
   "grows": {
    "spells.*.dcBonus[foes denied their Dex bonus]": {
     "2": 1,
     "10": 2,
     "18": 3
    },
    "spells.*.casterLevel[spell resistance of foes denied their Dex bonus]": {
     "2": 0,
     "6": 2,
     "14": 4
    }
   }
  },
  "Trap Sense": {
   "shownIn": "defensiveAbilities",
   "adjustments": {
    "saves.ref[traps]": "1 + floor(({level.bard} - 3) / 3)",
    "ac[traps]": {
     "value": "1 + floor(({level.bard} - 3) / 3)",
     "type": "dodge"
    }
   }
  },
  "Sneak Attack": {
   "shownIn": "specialAttack",
   "adjustments": {
    "amounts.sneak attack": 1,
    "specialAttack": {
     "name": "Sneak Attack",
     "description": "+1d6 damage at 5th level, +1d6 every five levels after, against a target within 30 feet that he flanks or that is denied its Dex bonus to AC against him",
     "active": false,
     "adjustments": {
      "melee.*.damageDice": "{feature:Sneak Attack}d6",
      "ranged.*.damageDice": "{feature:Sneak Attack}d6"
     }
    }
   },
   "grows": {
    "amounts.sneak attack": {
     "5": 1,
     "10": 2,
     "15": 3,
     "20": 4
    }
   },
   "descriptionOnly": "its dice are added to the attacks while it is on (switched on for an attack that can sneak attack: a target within 30 feet, flanked or denied its Dex bonus)"
  }
 }
}
