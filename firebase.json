{
  "hosting": {
    "public": "dist/pf1-character-app/browser",
    "ignore": ["firebase.json", "**/.*", "**/*.map"],
    "rewrites": [
      {"source": "**", "destination": "/index.csr.html"}
    ],
    "headers": [
      {"regex": "^[^.]*$", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/index.csr.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**/*.@(js|css)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
    ]
  }
}
